# KaamSetu Backend Configuration Template
# Copy this file to .env and adjust variables for your local development environment.

# Application Environment
APP_ENV=development
APP_NAME=KaamSetu-Backend
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production

# Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173"]

# PostgreSQL + PostGIS Database Settings
POSTGRES_USER=kaamsetu_user
POSTGRES_PASSWORD=kaamsetu_secure_dev_password
POSTGRES_DB=kaamsetu_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Connection URLs (Asyncpg for app, standard for alembic migrations)
DATABASE_URL=postgresql+asyncpg://kaamsetu_user:kaamsetu_secure_dev_password@localhost:5432/kaamsetu_db
DATABASE_URL_SYNC=postgresql://kaamsetu_user:kaamsetu_secure_dev_password@localhost:5432/kaamsetu_db

# Local Isolated Test Database (Used strictly for pytest unit tests when PostgreSQL is offline)
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# External Provider Abstractions (development mocks vs production providers)
OTP_PROVIDER=mock_console
SMS_PROVIDER=mock_sms
STORAGE_PROVIDER=local_disk
MAPS_PROVIDER=osm_nominatim
PAYMENT_PROVIDER=manual_upi_reconciliation

# Security & Rate Limiting
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
